worker_processes auto;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;

  access_log /dev/stdout;
  sendfile on;
  keepalive_timeout 65;

  client_body_temp_path /tmp/nginx-client;
  proxy_temp_path       /tmp/nginx-proxy;
  fastcgi_temp_path     /tmp/nginx-fastcgi;
  uwsgi_temp_path       /tmp/nginx-uwsgi;
  scgi_temp_path        /tmp/nginx-scgi;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  server {
    listen ${PORT};

    root /app/frontend/dist;
    index index.html;

    location /api/products        { proxy_pass http://catalog:8080; }
    location /api/payments        { proxy_pass http://payment:8081; }
    location /api/cart            {
      proxy_pass http://cart:8082;
      proxy_read_timeout 60s;
      proxy_send_timeout 60s;
    }
    location /api/images          { proxy_pass http://images:8083; }
    location /api/shipping        { proxy_pass http://shipping:8084; }
    location /api/recommendations { proxy_pass http://recommendations:8085; }
    location /static              { proxy_pass http://images:8083; }
    # Fault-injection control plane. SSE-friendly: long timeout, no buffering.
    location /admin/faults {
      proxy_pass http://controlplane:8086;
      proxy_buffering off;
      proxy_cache off;
      proxy_read_timeout 1h;
      proxy_send_timeout 1h;
      chunked_transfer_encoding on;
    }

    location / {
      try_files $uri $uri/ /index.html;
    }
  }
}
