worker_processes auto;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;

  access_log /dev/stdout;
  sendfile on;
  keepalive_timeout 65;

  client_body_temp_path /tmp/nginx-client;
  proxy_temp_path       /tmp/nginx-proxy;
  fastcgi_temp_path     /tmp/nginx-fastcgi;
  uwsgi_temp_path       /tmp/nginx-uwsgi;
  scgi_temp_path        /tmp/nginx-scgi;

  # OTLP-HTTP bodies (protobuf) can exceed the 1MB nginx default when many
  # spans batch together. 4MB matches the collector's default request cap.
  client_max_body_size 4m;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  server {
    listen ${PORT};

    root /app/frontend/dist;
    index index.html;

    location /api/products        { proxy_pass http://catalog:8080; }
    location /api/payments        { proxy_pass http://payment:8081; }
    location /api/cart            {
      proxy_pass http://cart:8082;
      proxy_read_timeout 60s;
      proxy_send_timeout 60s;
    }
    location /api/images          { proxy_pass http://images:8083; }
    location /api/shipping        { proxy_pass http://shipping:8084; }
    location /api/recommendations { proxy_pass http://recommendations:8085; }
    location /static              { proxy_pass http://images:8083; }
    # Fault-injection control plane. SSE-friendly: long timeout, no buffering.
    location /admin/faults {
      proxy_pass http://controlplane:8086;
      proxy_buffering off;
      proxy_cache off;
      proxy_read_timeout 1h;
      proxy_send_timeout 1h;
      chunked_transfer_encoding on;
    }

    # Browser RUM egress. Same-origin so no CORS. entrypoint.sh renders
    # ${OTEL_COLLECTOR_HOST} / ${OTEL_COLLECTOR_PORT} before nginx starts;
    # when unset the location 502s and the SDK batches drop harmlessly.
    location /v1/traces {
      proxy_pass http://${OTEL_COLLECTOR_HOST}:${OTEL_COLLECTOR_PORT}/v1/traces;
      proxy_read_timeout 30s;
      proxy_send_timeout 30s;
    }
    location /v1/logs {
      proxy_pass http://${OTEL_COLLECTOR_HOST}:${OTEL_COLLECTOR_PORT}/v1/logs;
      proxy_read_timeout 30s;
      proxy_send_timeout 30s;
    }
    location /v1/metrics {
      proxy_pass http://${OTEL_COLLECTOR_HOST}:${OTEL_COLLECTOR_PORT}/v1/metrics;
      proxy_read_timeout 30s;
      proxy_send_timeout 30s;
    }

    # Cache-buster: /rum-config.js is regenerated on every container start,
    # so serving a stale copy would leave clients pointing at old config.
    # Rendered by entrypoint.sh into /tmp because the container runs as
    # UID 65532 and cannot write into the root-owned /app/frontend/dist.
    location = /rum-config.js {
      add_header Cache-Control "no-store" always;
      alias /tmp/rum-config.js;
    }

    location / {
      try_files $uri $uri/ /index.html;
    }
  }
}
