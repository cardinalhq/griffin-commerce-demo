# Stage 1: build the Svelte frontend
FROM node:24-alpine AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# Stage 2: runtime image bundling the Go binary, frontend dist, and config
FROM node:24-alpine
ARG TARGETPLATFORM

WORKDIR /app

RUN apk add --no-cache ca-certificates curl bash nginx gettext && \
    addgroup -g 65532 nonroot && \
    adduser -D -u 65532 -G nonroot nonroot

COPY $TARGETPLATFORM/griffin /app/bin/
COPY services/images/static /app/services/images/static
COPY products.yaml /app/products.yaml
COPY config.yaml /app/config.yaml
COPY entrypoint.sh /app/entrypoint.sh
COPY frontend/nginx.conf.template /app/nginx.conf.template
COPY frontend/rum-config.js.template /app/rum-config.js.template
COPY --from=frontend-builder /app/frontend/dist /app/frontend/dist

RUN chmod +x /app/bin/* /app/entrypoint.sh

USER 65532:65532

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:${PORT:-5173}/ || exit 1

EXPOSE 5173

ENTRYPOINT ["/app/entrypoint.sh"]
